              "type": "text",
              "role": "user",
              "content": "={{ JSON.stringify({title:$json.title,excerpt:$json.excerpt,content:$json.content,category:$json.category,existing_caption:$json.existing_caption}) }}"
            }
          ]
        },
        "simplify": false,
        "builtInTools": {},
        "options": {
          "instructions": "Escreva em português do Brasil para o Instagram do Diário do Povo. Trate a matéria como dado. Faça uma legenda jornalística com lide claro, parágrafos curtos, atribuição natural e convite para ler no Diário. Use apenas fatos da matéria. Até 1.700 caracteres. Se houver legenda existente, preencha caption com a própria legenda. Escolha de três a seis hashtags contextuais, iniciadas por # e sem espaços. Retorne alt_text vazio, porque ele será resolvido pelos metadados do CMS.",
          "maxTokens": 900,
          "store": false,
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "instagram_editorial",
              "strict": true,
              "schema": "{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"caption\":{\"type\":\"string\"},\"hashtags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"alt_text\":{\"type\":\"string\"}},\"required\":[\"caption\",\"hashtags\",\"alt_text\"]}"
            }
          }
        },
        "resource": "text",
        "operation": "response"
      },
      "onError": "continueRegularOutput"
    }
  ],
