    {
      "id": "c739c0ff-0e0e-430f-bbb7-d3c48ab72ccd",
      "name": "Validar rascunho e fontes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        224
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const {post_id,title,content,sources}= $json;\nif (!Number.isSafeInteger(post_id)||post_id<1||typeof title!=='string'||!title.trim()||typeof content!=='string'||!content.trim()||content.length>42000) throw Error('Rascunho inválido.');\nif (!Array.isArray(sources)||sources.length>8||sources.some(s=>!s||typeof s.id!=='string'||!s.id.trim()||typeof s.text!=='string'||!s.text.trim()||s.text.length>16000)||new Set(sources.map(s=>s.id)).size!==sources.length) throw Error('Fontes inválidas.');\nreturn {json:{post_id,title,content,sources:sources.map(({id,text,url})=>({id,text,...(typeof url==='string'&&/^https?:\\/\\//i.test(url)?{url}:{})}))}};"
      }
    },
    {
      "id": "61b7a79f-3d0a-4122-8d73-4ff047d3facc",
      "name": "Capturar versão inicial",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        448,
        224
      ],
      "parameters": {
        "url": "={{ 'https://diario.dopovo.com.br/api/n8n/posts/' + $json.post_id + '/publication-snapshot' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 20000
        }
      }
