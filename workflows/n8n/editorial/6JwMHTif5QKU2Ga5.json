    {
      "id": "15c36a00-859b-48d7-9c0c-2e7b33678838",
      "name": "Preparar somente rascunho",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const {briefing,proposal,pauta_id,sources,editorialReview,category_id,author_id}=$json;\nif($json.decision!=='recomendar_publicacao'||briefing?.action!=='abrir'||briefing.target_id!==0||!/^https?:\\/\\//i.test(briefing.source?.url??'')||typeof proposal?.title!=='string'||!proposal.title.trim()||typeof proposal.content!=='string'||!proposal.content.trim()||!Number.isSafeInteger(category_id)||category_id<1||!Number.isSafeInteger(author_id)||author_id<1)throw Error('Proposta inédita ou identificação editorial inválida.');\nreturn {json:{pauta_id,proposal,briefing,sources:sources??[],editorialReview,open_questions:$json.open_questions??[],publish_enabled:$json.publish_enabled===true,request:{title:proposal.title,excerpt:proposal.excerpt,content:proposal.content,content_markdown:proposal.content,category_id,author_id,original_link:briefing.source.url,status:'draft'}}};"
      }
    },
    {
      "id": "d7a4733e-e9f8-46b5-8e35-a91c093906a9",
      "name": "Salvar rascunho no CMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        448,
        96
      ],
      "parameters": {
        "method": "POST",
        "url": "https://diario.dopovo.com.br/api/n8n/posts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "7086ff0c-93bc-4fb1-ac83-4f9319378b13",
      "name": "Confirmar novo rascunho",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original=$('Preparar somente rascunho').item.json;\nif(!$json.success||$json.data?.reused!==false||$json.data.status!=='draft'||!Number.isSafeInteger($json.data.id))throw Error('O CMS não confirmou um novo rascunho. Verifique duplicidade antes de continuar.');\nreturn {json:{...original,post_id:$json.data.id}};"
      }
    },
    {
      "id": "76988e02-24fa-4c89-a3f1-93b3abcc84a5",
      "name": "Ler versão gravada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        896,
        96
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://diario.dopovo.com.br/api/n8n/posts/' + $json.post_id + '/publication-snapshot' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "61b2eede-cd10-4d54-911b-fdeb56b4e7d2",
      "name": "Preparar reavaliação da versão gravada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input=$('Confirmar novo rascunho').item.json;\nconst d=$json.data;\nif(!$json.success||d?.id!==input.post_id||!d.snapshot||typeof d.content!=='string'||typeof d.title!=='string')throw Error('Versão do CMS indisponível.');\nreturn {json:{...input,title:d.title,excerpt:d.excerpt??undefined,content:d.content,changes:input.proposal.changes??[],pending:input.open_questions,original:{title:input.proposal.title,excerpt:input.proposal.excerpt,content:input.proposal.content},snapshot:d.snapshot}};"
      }
    },
    {
      "id": "7c391031-fb26-4a65-bb25-4159bda3014b",
      "name": "Reavaliar no Editor Executivo",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1344,
        96
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "By1lAit6fNfvDDBs"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "b2cf93df-55b0-4332-b3e4-d9e13cb8aba2",
      "name": "Conferir autorização da versão",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d=$('Preparar reavaliação da versão gravada').item.json;\nconst ready=$json.decision==='recomendar_publicacao'&&$json.post_id===d.post_id&&$json.proposal?.title===d.title&&$json.proposal?.excerpt===d.excerpt&&$json.proposal?.content===d.content&&Array.isArray($json.blocking_issues)&&$json.blocking_issues.length===0;\nreturn {json:{post_id:d.post_id,decision:$json.decision,reason:$json.reason,ready:ready&&d.publish_enabled,request:ready?{snapshot:d.snapshot,evaluated_title:d.title,evaluated_excerpt:d.excerpt,evaluated_content:d.content,decision:$json.decision,reason:$json.reason,execution_id:String($execution.id),blocking_issues:[]}:null}};"
      }
    },
    {
      "id": "c1275b6a-9a07-4646-8d06-dae6f7ed36e7",
      "name": "Publicação habilitada e aprovada?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1792,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ready ? 'sim' : 'não' }}",
              "rightValue": "sim",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
