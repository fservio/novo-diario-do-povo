    {
      "id": "1ceefd65-4457-4a50-a7cd-2cfb8c73dab7",
      "name": "Validar rascunho e fontes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        224
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const {post_id,title,content,sources}= $json;\nif (!Number.isSafeInteger(post_id)||post_id<1||typeof title!=='string'||!title.trim()||typeof content!=='string'||!content.trim()||content.length>42000) throw Error('Rascunho inválido.');\nif (!Array.isArray(sources)||sources.length>8||sources.some(s=>!s||typeof s.id!=='string'||!s.id.trim()||typeof s.text!=='string'||!s.text.trim()||s.text.length>16000)||new Set(sources.map(s=>s.id)).size!==sources.length) throw Error('Fontes inválidas.');\nreturn {json:{post_id,title,content,sources:sources.map(({id,text})=>({id,text}))}};"
      }
    },
    {
      "id": "4b519d31-4b89-472a-aacc-05faeaa51c9e",
      "name": "Capturar versão inicial",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        448,
        224
      ],
      "parameters": {
        "url": "={{ 'https://diario.dopovo.com.br/api/n8n/posts/' + $json.post_id + '/publication-snapshot' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 20000
        }
