      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        144
      ],
      "parameters": {
        "jsCode": "const reviews=$('Parecer encaminhado?').all(0);\nconst answers=$input.all();\nreturn reviews.map((item,index)=>{\n const review=item.json;\n const googleFactCheck=answers.filter(a=>a.json.post_id===review.post_id).map(({json:{claim_index,status,candidates}})=>({claim_index,status,candidates}));\n return {json:{...review,googleFactCheck,decision:'devolver_para_ajuste',reason:review.reason+' Na revisão, preserve placares, datas, competições e atribuições. As checagens encontradas são candidatas.'},pairedItem:{item:Math.max(0,answers.findIndex(a=>a.json.post_id===review.post_id))}};\n});"
      }
    },
