{
  "id": "Gr6yE2uLEeIGnpyd",
  "name": "NewsExtractor — encaminhar rascunhos à editoria",
  "versionId": "4b50921d-75fb-41b1-84e7-5b09fc73b619",
  "nodes": [
    {
      "id": "29d74e89-4f15-494c-9e42-c0e66b917b16",
      "name": "Receber rascunho",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
