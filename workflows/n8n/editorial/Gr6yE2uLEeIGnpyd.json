    {
      "id": "b7093f28-ea78-464e-87ad-1bb4b583f1b3",
      "name": "Consultar editoria no CMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        224,
        96
      ],
      "parameters": {
        "url": "={{ 'https://diario.dopovo.com.br/api/n8n/posts/' + $json.post_id + '/publication-snapshot' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "7f251d66-c136-4b0b-82d3-88b0f86c5959",
      "name": "Preparar registro e encaminhamento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $('Receber rascunho').item.json;\nconst draft = $json.body?.data;\nconst valid = $json.statusCode === 200 && draft?.id === input.post_id && ['draft', 'review'].includes(draft.status);\nconst category = valid ? draft.category_id : null;\nconst routes = {\"1\":\"2H2NpSmmUo1ODc3I\",\"2\":\"3HTVVuEfBWRV8Kls\",\"6\":\"Kt3HeSrKsqMn5MCO\",\"12\":\"lV8zgljFC2ZgBqKr\",\"4\":\"cM4S8MLF3jYyfXwa\",\"8\":\"H8M2aXLuhb5anp3o\",\"9\":\"rhZgVclsjYuFK3Hm\",\"11\":\"iScn5deYNVMwWw12\",\"13\":\"dQolgkh2bvbqfYvB\",\"14\":\"0GJMBdH0j0Ting6q\"};\nconst editor = routes[category] ?? '';\nreturn {json:{post_id:input.post_id,category_id:category,title:input.title,content:input.content,sources:input.sources,sources_json:JSON.stringify(input.sources),editor,status:editor?'aguardando_resultado':valid?'aguardando_editor':'conferir_rascunho',reason:editor?'Rascunho encaminhado para revisão.':valid?'Editoria sem fluxo de revisão confirmado.':'O CMS não confirmou um rascunho disponível.'}};"
      }
    },
    {
      "id": "1a3262b8-dc80-4710-8421-f6c3fa3e4753",
      "name": "Guardar fontes e situação",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        672,
        96
      ],
      "parameters": {
        "resource": "row",
        "operation": "upsert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "TAkh5fZLw3FEmIoR"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "post_id",
              "condition": "eq",
              "keyValue": "={{ $json.post_id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "post_id": "={{ $json.post_id }}",
            "category_id": "={{ $json.category_id }}",
            "title": "={{ $json.title }}",
            "sources_json": "={{ $json.sources_json }}",
            "status": "={{ $json.status }}",
            "reason": "={{ $json.reason }}"
          },
          "schema": [
            {
              "id": "post_id",
              "displayName": "post_id",
              "type": "number",
              "display": true
            },
            {
              "id": "category_id",
              "displayName": "category_id",
              "type": "number",
              "display": true
            },
            {
              "id": "title",
              "displayName": "title",
              "type": "string",
              "display": true
            },
            {
              "id": "sources_json",
              "displayName": "sources_json",
              "type": "string",
              "display": true
            },
            {
              "id": "status",
              "displayName": "status",
              "type": "string",
              "display": true
            },
            {
              "id": "reason",
              "displayName": "reason",
              "type": "string",
              "display": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "37fbf91d-fd34-4f50-b146-2b4632aad013",
      "name": "Restaurar dados para o editor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const prepared = $('Preparar registro e encaminhamento').item.json;\nif ($json.post_id !== prepared.post_id) throw Error('A fila não confirmou o rascunho.');\nreturn {json:{post_id:prepared.post_id,title:prepared.title,content:prepared.content,sources:prepared.sources,editor:prepared.editor,status:prepared.status,reason:prepared.reason}};"
      }
    },
    {
      "id": "67186512-2268-4f27-9221-6d44b19bde76",
      "name": "Há editor para a categoria?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1120,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.editor !== '' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "3ae07c0f-12eb-4083-baeb-d906f7f0facc",
      "name": "Encaminhar ao editor da categoria",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.editor }}"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "ec7d5501-a75a-4bee-b8c8-44743c53a2c2",
      "name": "Registrar resultado recebido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input=$('Restaurar dados para o editor').item.json;\nif ($json.error || $json.post_id!==input.post_id) {\n  const reason=$json.error?.message??$json.error??'O editor não retornou uma decisão para este rascunho.';\n  return {json:{post_id:input.post_id,status:'falha_revisao',reason:String(reason).slice(0,500)}};\n}\nreturn {json:{post_id:input.post_id,status:$json.status==='published'?'publicado':'revisao_editorial',reason:$json.status==='published'?'Publicação confirmada pelo CMS.':String($json.reason??'Verificar o parecer do editor.').slice(0,500)}};"
      }
    },
    {
      "id": "8f70478d-dbde-4026-8966-b19e9c18a002",
      "name": "Atualizar situação na fila",
