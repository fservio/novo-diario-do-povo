    {
      "id": "5cbf2f6b-8c6d-4f08-9dff-f4e33e5f1826",
      "name": "Conferir autorização",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $('Conferir prévia').item.json;\nconst ready = $json.decision === 'recomendar_publicacao' && $json.post_id === d.post_id && $json.proposal?.title === d.title && $json.proposal?.excerpt === d.excerpt && $json.proposal?.content === d.content && Array.isArray($json.blocking_issues) && !$json.blocking_issues.length;\nreturn {json:{post_id:d.post_id,pauta_id:d.pauta_id,ready,status:ready?'ready':'devolvida',reason:$json.reason,request:ready?{...d.request,snapshot:d.snapshot,evaluated_content:d.content,decision:$json.decision,reason:$json.reason,execution_id:String($execution.id),blocking_issues:[]}:null}};"
      }
    },
    {
      "id": "366314ef-5f0d-4e20-ae21-166243f6e280",
      "name": "Pode gravar?",
