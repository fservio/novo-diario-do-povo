            "name": "AI Journalist"
        },
        {
            "parameters": {
                "jsCode": "const item = items[0];\nif (item.binary && item.binary.data) {\n  return [{ json: { success: true, needs_download: false }, binary: item.binary }];\n}\nif (item.json && (item.json.url || (item.json.data && item.json.data[0] && item.json.data[0].url))) {\n  const url = item.json.url || item.json.data[0].url;\n  return [{ json: { success: true, needs_download: true, download_url: url } }];\n}\nreturn [{ json: { success: false, error: 'No image data or URL found' } }];"
            },
