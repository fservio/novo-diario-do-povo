        {
            "parameters": {
                "jsCode": "const aiOutput = $('AI Journalist1').first().json.output;\nlet parsed = {};\ntry {\n  // 1. Limpar cleanups básicos\n  let jsonStr = aiOutput.replace(/```json/g, '').replace(/```/g, '').trim();\n  \n  // 2. Encontrar os limites do objeto JSON\n  const firstOpen = jsonStr.indexOf('{');\n  const lastClose = jsonStr.lastIndexOf('}');\n  \n  if (firstOpen !== -1 && lastClose !== -1) {\n    jsonStr = jsonStr.substring(firstOpen, lastClose + 1);\n  }\n\n  parsed = JSON.parse(jsonStr);\n} catch (e) {\n  // Fallback: Retornar o erro e o raw output para debug\n  parsed = {\n    title: $('RSS Read1').item.json.title,\n    hat: 'ERRO JSON',\n    content: `<p><strong>Erro de Parsing:</strong> ${e.message}</p><pre>${aiOutput}</pre>`,\n    excerpt: 'Erro ao processar IA',\n    tags: ''\n  };\n}\n\nreturn { json: { ...parsed, original_link: $('RSS Read1').item.json.link } };"
            },
