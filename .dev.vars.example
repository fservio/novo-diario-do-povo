# ==============================================================================
# CRITICAL: Essas variáveis são obrigatórias para inicialização do sistema.
# Copie este arquivo para .dev.vars e preencha com valores reais.
# ==============================================================================

# ==============================================================================
# JWT & Auth (OBRIGATÓRIO)
# ==============================================================================
JWT_SECRET=sua-chave-secreta-jwt-minimo-32-caracteres

# ==============================================================================
# Admin Bootstrap (OBRIGATÓRIO - Primeiro acesso)
# ==============================================================================
ADMIN_BOOTSTRAP_EMAIL=admin@exemplo.com
ADMIN_BOOTSTRAP_PASSWORD=SenhaForte123!

# ==============================================================================
# n8n Webhook (OBRIGATÓRIO para integração n8n)
# ==============================================================================
N8N_WEBHOOK_SECRET=sua-chave-secreta-n8n-minimo-32-caracteres

# ==============================================================================
# R2 Bucket (OBRIGATÓRIO)
# ==============================================================================
R2_BUCKET_NAME=jornal-media

# ==============================================================================
# Public Base URL (OBRIGATÓRIO)
# ==============================================================================
PUBLIC_BASE_URL=http://localhost:3000

# ==============================================================================
# Cloudflare Environment
# ==============================================================================
CF_ENV=dev

# ==============================================================================
# Push Notifications - VAPID Keys (OBRIGATÓRIO se usar push)
# Gerar com: npx web-push generate-vapid-keys
# ==============================================================================
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@exemplo.com

# ==============================================================================
# ASAAS (OBRIGATÓRIO para paywall/assinaturas)
# Nota: Essas são BOOTSTRAP KEYS apenas para dev/staging.
# Em produção, NÃO use env vars; configure via CMS (settings private).
# ==============================================================================
# IMPORTANTE: Remover ASAAS_BOOTSTRAP_API_KEY em produção!
ASAAS_BOOTSTRAP_API_KEY=
ASAAS_BOOTSTRAP_ENVIRONMENT=sandbox

# ==============================================================================
# Integrações Opcionais (controláveis via CMS também)
# ==============================================================================

# AdSense
ADSENSE_CLIENT_ID=

# Google Ad Manager
GAM_NETWORK_CODE=

# Newsletter Provider (smtp para Hostinger)
NEWSLETTER_PROVIDER=smtp
NEWSLETTER_API_KEY=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=newsletter@seu-dominio.com.br
SMTP_PASSWORD=
SMTP_FROM_EMAIL=newsletter@seu-dominio.com.br
SMTP_FROM_NAME=Diário do Povo
# Reserva 20 mensagens do limite real de 100/24h para testes e contingências.
NEWSLETTER_DAILY_LIMIT=80

# ==============================================================================
# OpenAI - Redação IA
# Configure como segredo no Cloudflare em produção. Nunca exponha no navegador.
# ==============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# ==============================================================================
# WhatsApp Business Platform - Cloud API oficial
# Em produção, ACCESS_TOKEN, APP_SECRET e VERIFY_TOKEN devem ser Secrets.
# O número deve usar formato internacional sem espaços ou símbolos.
# ==============================================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_BUSINESS_NUMBER=

# Stripe (se usar pagamentos diretos além de Asaas)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
