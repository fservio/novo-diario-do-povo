{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diario-instagram-scheduler",
  "main": "workers/instagram-scheduler.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "PUBLIC_BASE_URL": "https://diario.dopovo.com.br", "INSTAGRAM_GRAPH_VERSION": "v22.0" },
  "kv_namespaces": [{ "binding": "CACHE", "id": "b8db475118404ce5a080281154bcbb23" }],
  "d1_databases": [{ "binding": "DB", "database_name": "webapp-prod-v2", "database_id": "16c980b7-4c6f-45df-b315-b4b2d5b7ceaa" }]
}
