{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diario-agent-review",
  "main": "workers/agent-review.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "KV", "id": "0c7cffe1bf3b4a82b996519f376dab10" }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "webapp-media" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "webapp-prod-v2",
    "database_id": "16c980b7-4c6f-45df-b315-b4b2d5b7ceaa"
  }]
}
