{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "78184365-08ff-4bbc-a28a-4dfe33c1b2d1"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "ef54494bcf754b889308976043a8c47b"
    },
    {
      "binding": "CACHE",
      "id": "627e53560f4845948da9ef9f69a842cc"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "webapp-media"
    }
  ]
}
