{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jornal",
  "main": "functions/index.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jornal-production",
      "database_id": "REPLACE_WITH_ACTUAL_ID_AFTER_CREATION"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "REPLACE_WITH_ACTUAL_ID_AFTER_CREATION",
      "preview_id": "REPLACE_WITH_ACTUAL_PREVIEW_ID_AFTER_CREATION"
    },
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_ACTUAL_ID_AFTER_CREATION",
      "preview_id": "REPLACE_WITH_ACTUAL_PREVIEW_ID_AFTER_CREATION"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "jornal-media"
    }
  ]
}
