        {
            "parameters": {
                "jsCode": "// Function node (Execute Once = false)\n\nreturn items.map(item => {\n  // 1. Pega o HTML bruto\n  const key = Object.keys(item.json)[0];\n  const html = item.json[key] || \"\";\n  \n  // 2. Extrai o href do <a>\n  const hrefMatch = html.match(/<a[^>]*href=\"([^\"]+)\"/);\n  const relativePath = hrefMatch ? hrefMatch[1] : \"\";\n  const href = relativePath\n    ? `https://agenciabrasil.ebc.com.br${relativePath}`\n    : \"\";\n\n  // 3. Extrai o texto dentro de <div class=\"titulo-foto\">…</div>\n  const tituloMatch = html.match(/<div\\s+class=\"titulo-foto\">([\\s\\S]*?)<\\/div>/);\n  const rawText = tituloMatch\n    ? tituloMatch[1]\n        .replace(/<br\\s*\\/?>/g, '\\n')  \n        .replace(/&nbsp;/g, ' ')\n        .trim()\n    : \"\";\n\n  // 4. Separa o texto em title e foto (legenda após \"Foto:\")\n  let title = rawText;\n  let foto  = \"\";\n  const fotoIndex = rawText.indexOf(\"Foto:\");\n  if (fotoIndex !== -1) {\n    title = rawText.slice(0, fotoIndex).trim();\n    const fotoMatch2 = rawText.match(/Foto:\\s*([^<\\r\\n]+)/);\n    foto = fotoMatch2 ? fotoMatch2[1].trim() : \"\";\n  }\n\n  // 5. Retorna objeto com href completo, title e foto\n  return {\n    json: {\n      href,\n      title,\n      foto\n    }\n  };\n});\n"
            },
            "type": "n8n-nodes-base.code",
