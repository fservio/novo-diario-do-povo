            "parameters": {
                "jsCode": "const item = items[0];\n\n// 1. Se tem binário (Gemini)\nif (item.binary && item.binary.data) {\n  return [{\n    json: {\n      success: true,\n      needs_download: false\n    },\n    binary: item.binary\n  }];\n}\n\n// 2. Se tem URL (Caso mude de modelo)\nif (item.json && (item.json.url || (item.json.data && item.json.data[0] && item.json.data[0].url))) {\n  const url = item.json.url || item.json.data[0].url;\n  return [{\n    json: {\n      success: true,\n      needs_download: true,\n      download_url: url\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    success: false,\n    error: 'Image generation failed'\n  }\n}];"
