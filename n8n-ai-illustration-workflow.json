        {
            "parameters": {
                "jsCode": "const titulo = $('Webhook1').item.json.titulo_reescrito || 'Notícia';\nconst categoria = $('Webhook1').item.json.categoria || 'Geral';\nconst postId = $('Webhook1').item.json.post_id || null;\n\nconst uploadNode = $('Upload to Media Library1').item.json;\nconst mediaId = uploadNode.data ? uploadNode.data.id : null;\nconst imageUrl = uploadNode.data ? uploadNode.data.url : null;\nconst altText = `Ilustração editorial: ${titulo} - ${categoria}`;\n\nreturn [{\n  json: {\n    media_id: mediaId,\n    image_url: imageUrl,\n    post_id: postId,\n    alt_text: altText,\n    is_fallback: false\n  }\n}];"
