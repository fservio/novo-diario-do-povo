        {
            "parameters": {
                "jsCode": "const titulo = items[0].json.titulo_reescrito || 'Noticia';\nconst categoria = items[0].json.categoria || 'Geral';\nconst resumo = items[0].json.resumo_noticia ? items[0].json.resumo_noticia.substring(0, 150) : '';\nconst cat = categoria.toUpperCase();\n\nlet elementos = '';\nlet paleta = '';\nlet atmosfera = '';\n\nif (cat.includes('POL')) {\n  elementos = 'silhuetas estilizadas do Congresso Nacional, urnas e pedaços da bandeira do Brasil integrados em engrenagens';\n  paleta = 'verde-floresta escuro, amarelo-ouro desbotado e cinza concreto';\n  atmosfera = 'solene, tensa, institucional';\n} else if (cat.includes('TECH')) {\n  elementos = 'mãos humanas tocando circuitos digitais, interface holográfica saindo de papel antigo, cabos se transformando em raízes';\n  paleta = 'azul ciano elétrico, preto profundo e branco papel';\n  atmosfera = 'futurista, disruptiva, complexa';\n} else if (cat.includes('ECON')) {\n  elementos = 'moedas se equilibrando como arquitetura, gráfico de linha ascendente feito de corda vermelha, touro geométrico abstrato';\n  paleta = 'vermelho carmesim, dourado metálico e bege';\n  atmosfera = 'volátil, analítica, urgente';\n} else if (cat.includes('ESPORT')) {\n  elementos = 'movimento dinâmico de atletas com efeito de longa exposição, troféu fragmentado, linhas cinéticas de velocidade';\n  paleta = 'verde gramado vibrante, amarelo solar e azul royal';\n  atmosfera = 'enérgica, triunfante, competitiva';\n} else if (cat.includes('CULTUR')) {\n  elementos = 'cabeça de estátua clássica com fones de ouvido, rolos de filme se desenrolando como estradas, pinceladas abstratas';\n  paleta = 'magenta vivo, violeta e texturas de papel envelhecido';\n  atmosfera = 'expressiva, sofisticada, onírica';\n} else {\n  elementos = 'globo terrestre feito de quebra-cabeça, lupa focando em detalhes de papel, relógio derretendo';\n  paleta = 'azul marinho, vermelho tijolo e off-white';\n  atmosfera = 'informativa, séria, investigativa';\n}\n\nconst finalPrompt = `Editorial illustration collage regarding '${titulo}'. Context: ${resumo}. Visual Metaphors: ${elementos}. Art Style: Mixed media editorial collage, grainy paper textures, bold vector elements. MOOD: ${atmosfera}. NO TEXT.`;\n\nreturn [{ json: { prompt: finalPrompt, titulo: titulo, categoria: categoria } }];"
            },
